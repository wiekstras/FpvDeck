#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
idf_dir="$repo_root/.deps/esp-idf"

if [[ ! -d "$idf_dir/.git" ]]; then
    git clone --branch v6.1 --depth 1 --recursive \
        https://github.com/espressif/esp-idf.git "$idf_dir"
fi
git -C "$idf_dir" submodule update --init --recursive
"$idf_dir/install.sh" esp32p4
echo "ESP-IDF v6.1 ready. Build with ./scripts/build-firmware"
