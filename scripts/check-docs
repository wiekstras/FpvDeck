  docs/DEVELOPMENT.md docs/TOUCH_UX.md docs/ROADMAP.md docs/RISK_REGISTER.md
  docs/REVERSE_ENGINEERING.md
  docs/TEST_PCB_BRINGUP.md
  CONTRIBUTING.md SECURITY.md LICENSE
  docs/assets/renders/README.md docs/assets/renders/fpvdeck-concept-render-v2.png
  docs/assets/ui/README.md docs/assets/ui/home.png docs/assets/ui/fpv.png
  docs/assets/ui/battery.png docs/assets/ui/media.png docs/assets/ui/flights.png
  docs/assets/ui/media-playback.png docs/assets/ui/receiver.png
  docs/assets/ui/diagnostics.png docs/assets/branding/fpvdeck-icon.svg
  docs/assets/branding/fpvdeck-wordmark.svg docs/assets/branding/social-preview.svg
  docs/assets/diagrams/overall-system.svg docs/assets/diagrams/overall-system.mmd
  docs/assets/diagrams/video-pipeline.mmd docs/assets/diagrams/video-pipeline.svg
  docs/assets/diagrams/power-architecture.mmd docs/assets/diagrams/power-architecture.svg
  docs/assets/diagrams/software-architecture.mmd docs/assets/diagrams/software-architecture.svg
  hardware/research/COMPONENT_SELECTION.md hardware/research/VRX_COMPARISON.md
  hardware/research/DISPLAY_COMPARISON.md hardware/research/SBC_COMPARISON.md
  hardware/research/VIDEO_DECODER_COMPARISON.md hardware/research/ADC_COMPARISON.md
  hardware/ORDER_LIST.md hardware/PROCUREMENT_PLAN.md
